write_data      relaxed.coo
System init for write_data ...
reset_timestep  0

#########################################################
#                       LOG                             #
#########################################################
# Required                                              #
# 1) Define step per loggin *log_step*                  #
# 2) Check out thermo_style custom                      #
# 3) The default path would be *dump.lammps*            #
# 4) Element list should be defined                     #
#########################################################
variable        log_step        equal   100
thermo_style    custom          step pe ke etotal fmax press cpu tpcpu spcpu
thermo          ${log_step}
thermo          100

dump            my_dump     all custom ${log_step} dump.lammps                             id type element xu yu zu fx fy fz
dump            my_dump     all custom 100 dump.lammps                             id type element xu yu zu fx fy fz
dump_modify     my_dump     sort id     element ${element_list}
dump_modify     my_dump     sort id     element H N F Si I

#########################################################
#                 NVT MD variables                      #
#########################################################
# Required                                              #
# 1) Define MD temperature *T_nvt*                      #
# 2) Check out timestep (default: 1 fs)                 #
# 3) Define MD time *time_nvt*                          #
# 4) Set the random seed                                #
#########################################################
# variable        T_nvt           equal   my_temp
variable        timestep_nvt    equal   0.001       # ps unit
timestep        ${timestep_nvt}                     # ps unit
timestep        0.001                     
# variable        time_nvt        equal   my_md_time
variable        step_nvt        equal   $(round(v_time_nvt/v_timestep_nvt))
variable        step_nvt        equal   10000
variable        T_damp          equal   $(v_timestep_nvt*100)
variable        T_damp          equal   0.10000000000000000555

#########################################################
#                 NVE + NVT MD                          #
#########################################################
# Required                                              #
# 1) Set the Move region & group, to set NVT MD         #
# 2) If reflection required, check it.                  #
#########################################################
# variable    h_nvt      equal   8.0
region      rMove      block   EDGE EDGE   EDGE EDGE   ${fix_h} EDGE
region      rMove      block   EDGE EDGE   EDGE EDGE   4 EDGE
group       gMove      region  rMove
118 atoms in group gMove
velocity    gMove      create ${T_nvt} ${SEEDS} dist gaussian
velocity    gMove      create 400 ${SEEDS} dist gaussian
velocity    gMove      create 400 11399 dist gaussian

# variable    h_reflect   equal   30.0
# fix         top         all wall/reflect zhi ${h_reflect}

fix         my_NVT      gMove    nvt     temp    ${T_nvt} ${T_nvt} ${T_damp}
fix         my_NVT      gMove    nvt     temp    400 ${T_nvt} ${T_damp}
fix         my_NVT      gMove    nvt     temp    400 400 ${T_damp}
fix         my_NVT      gMove    nvt     temp    400 400 0.1
# fix         my_NVT      all    nvt     temp    ${T_nvt} ${T_nvt} ${T_damp}

#########################################################
#                      Run                              #
#########################################################
run ${step_nvt}
run 10000
