#LAMMPS
#########################################################
#                      Basic Input                      #
#########################################################
# Required                                              #
# 1) Define atomic mass                                 #
# 2) Define element order                               #
# 3) Check out the input data file (read_data)          #
# 4) Check out the boundary condition                   #
#########################################################
units           metal     # K, bar, ps, A
box             tilt large

The 'box' command has been removed and will be ignored

boundary        p p p
newton          on

read_data       input.data
Reading data file ...
  triclinic box = (0 0 0) to (34.960529 30.276706 40) with tilt (0 0 0)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  1674 atoms
  read_data CPU = 0.402 seconds

variable        m_Si       equal   28.0855
variable        m_N        equal   14.0067
variable        m_H        equal   1.0078
variable        m_F        equal   18.9984
variable        m_I        equal   126.90447

mass        1   ${m_H}
mass        1   1.0078
mass        2   ${m_N}
mass        2   14.0067
mass        3   ${m_F}
mass        3   18.9984
mass        4   ${m_Si}
mass        4   28.0855
mass        5   ${m_I}
mass        5   126.90447

variable        element_list    string  "H N F Si I"

#########################################################
#                SEVENNET-0 + D3  hybrid                #
#########################################################
# Required                                              #
# 1) element_list                                       #
#########################################################
pair_style      hybrid/overlay  e3gnn   d3 9000 1600 damp_bj pbe
PairE3GNN using device : CUDA
pair_coeff      * *  e3gnn  ${path_potential}  ${element_list}
pair_coeff      * *  e3gnn  /data2_1/team_lowtetch/potentials/high_conc_hf/large/vanilla/deployed_epoch_1000.pt  ${element_list}
pair_coeff      * *  e3gnn  /data2_1/team_lowtetch/potentials/high_conc_hf/large/vanilla/deployed_epoch_1000.pt  H N F Si I
Chemical specie 'H' is assigned to type 1
Chemical specie 'N' is assigned to type 2
Chemical specie 'F' is assigned to type 3
Chemical specie 'Si' is assigned to type 4
Chemical specie 'I' is assigned to type 5
from sevenn version '0.9.2' single precision model trained at 2024-12-04 is loaded
pair_coeff      * *  d3     ${element_list}
pair_coeff      * *  d3     H N F Si I

#########################################################
#                   Slab settings                       #
#########################################################
# Required                                              #
# 1) check out the fix height (default: 3.0)            #
#########################################################
variable    fix_h       equal   4.0
region      rFixed      block   INF INF INF INF 0.0 ${fix_h}
region      rFixed      block   INF INF INF INF 0.0 4
group       gBottom     region  rFixed
612 atoms in group gBottom
velocity    gBottom     set     0.0 0.0 0.0
fix         frz_bot     gBottom     setforce    0.0 0.0 0.0

#########################################################
#                 minimize                              #
#########################################################
min_style       cg
minimize        0 0.02 100000 100000
